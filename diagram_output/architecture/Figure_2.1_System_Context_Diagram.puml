@startuml

skinparam dpi 200
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B
skinparam ArrowColor #1F3A5F
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #1E293B
skinparam ArrowFontSize 11
skinparam TitleFontColor #1F3A5F
skinparam TitleFontSize 15
skinparam PackageBorderColor #1F3A5F
skinparam PackageBackgroundColor #F8FAFC
skinparam PackageFontColor #1F3A5F
skinparam PackageFontSize 12
skinparam RectangleBorderColor #1F3A5F
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontColor #1F3A5F
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B
skinparam NoteFontColor #1E293B
skinparam NoteFontSize 11

title GraphMind Enterprise Knowledge Platform — System Context Diagram
left to right direction

package "Enterprise Human Actors (RBAC Scoped)" as Actors {
    rectangle "**System & IT Administrator**\n(it_admin)\n• Dynamic 2D RBAC Matrix\n• Accounts, Audit & Kill Switch" as ITAdmin #EAF2FF
    rectangle "**Knowledge Administrator**\n(knowledge_manager)\n• Document Approval Queue\n• KG Editor & SOP Publishing" as KAdmin #EAF2FF
    rectangle "**Executive**\n(executive)\n• Enterprise KPI & Risk Alerts\n• Cross-Dept Copilot & Summaries" as Exec #EAF2FF
    rectangle "**Department Manager**\n(manager)\n• Shift Handover Sign-Off\n• Dept Copilot & Daily Consolidation" as Mgr #EAF2FF
    rectangle "**Standard User**\n(staff)\n• Internal Doc Upload & Shift Report\n• Dept-Scoped AI Copilot & OTP" as Staff #EAF2FF
}

rectangle "**SYSTEM GRAPHMIND PLATFORM**\n(Enterprise Knowledge Management & Decision Support System)\n--------------------------------------------------------------------------------\n• **Web SPA Frontend** (React 18 + Vite + Tailwind CSS)\n• **Core API Gateway & Services** (FastAPI + JWT/JTI Session Guard)\n• **Security & Governance Layer** (2D RBAC Matrix + Read-Only Cypher Guard)\n• **Hybrid GraphRAG Orchestrator** (Text-to-Cypher + Vector RRF Fusion)\n• **Async Ingestion & Shift Consolidation Workers** (Celery Task Queue)" as Core #FFFBEB;line:1F3A5F;line.bold

package "External Systems, Agents & Data Infrastructure" as Ext {
    rectangle "**AEGIS Local Agent**\n(Windows Workstations)\n• Incremental File Watcher\n• 30s WSS Heartbeat & Kill Switch" as Aegis #F1F5F9
    rectangle "**Enterprise Data Stores**\n(PostgreSQL / Neo4j / Qdrant / Redis)\n• 10 Relational Tables & JTI Blacklist\n• Knowledge Graph & 768-d Vectors" as DBs #DCFCE7
    rectangle "**Self-Hosted AI Engine**\n(Ollama Qwen2.5-7B-Instruct LoRA)\n• NER/RE & Text-to-Cypher\n• Shift Consolidation + Fallback" as Ollama #EAF2FF
    rectangle "**Cloud Storage APIs**\n(Google Drive / Google Sheets)\n• External Dataset & Document Sync\n• OAuth 2.0 Authorization" as Cloud #F1F5F9
    rectangle "**SMTP Mail Server**\n(Transactional Email Service)\n• 6-Digit Password Recovery OTP\n• Security & Approval Notifications" as Smtp #F1F5F9
}

ITAdmin <--> Core : "Configure 2D RBAC, Manage Users,\nTrigger Kill Switch & View Audit Logs"
KAdmin <--> Core : "Approve/Reject Uploaded Docs,\nTrigger ETL & Curate Knowledge Graph"
Exec <--> Core : "Query Enterprise Copilot, View KPIs,\nRisk Alerts & Daily Shift Summaries"
Mgr <--> Core : "Review & Sign-Off Shift Reports,\nTrigger Consolidation & Query Dept Data"
Staff <--> Core : "Upload Pending Docs, Submit Shifts,\nQuery Copilot & Request Email OTP"

Core <--> Aegis : "HTTPS/WSS: Incremental File Sync,\n30s Heartbeat & EMERGENCY_KILL (<=3s)"
Core <--> DBs : "Read/Write Relational Entities, Graph\nTriples, Vector Chunks & Session JTI"
Core <--> Ollama : "Send ChatML Prompts & Fused Context;\nReturn Citations, Cypher & Summaries"
Core <--> Cloud : "OAuth 2.0 Incremental Document\n& Spreadsheet Synchronization"
Core --> Smtp : "Dispatch 6-Digit Email OTP (300s TTL)\n& Workflow Alert Notifications"

@enduml