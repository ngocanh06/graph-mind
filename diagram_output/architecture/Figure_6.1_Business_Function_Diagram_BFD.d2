direction: down

classes: {
  root_node: {
    style: {
      fill: "#1F3A5F"
      stroke: "#1F3A5F"
      font-color: "#FFFFFF"
      bold: true
      border-radius: 6
    }
  }
  pillar: {
    style: {
      fill: "#3B82F6"
      stroke: "#1F3A5F"
      font-color: "#FFFFFF"
      bold: true
      border-radius: 6
    }
  }
  func_node: {
    style: {
      fill: "#EAF2FF"
      stroke: "#3B82F6"
      font-color: "#1F3A5F"
      border-radius: 4
    }
  }
}

ROOT: "GraphMind Enterprise Knowledge & Operational Intelligence Platform (EKAI v1.2)" {class: root_node}

