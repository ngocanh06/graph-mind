title Figure 6.8 — Document Approval & Ingestion State Machine Diagram (FR53–FR54)

[*] --> UPLOADED : User uploads file\n[Format valid, Size <= 50MB,\nSHA-256 hash unique (BR-06)]

state UPLOADED {
    UPLOADED : **Entry:** Compute SHA-256 checksum
    UPLOADED : **Do:** Store raw file in staging storage
}

UPLOADED --> PENDING_APPROVAL : Record created in documents table\n[status = 'PENDING_APPROVAL'] (FR53)

state PENDING_APPROVAL {
    PENDING_APPROVAL : **Entry:** Notify Knowledge Administrator
    PENDING_APPROVAL : **Do:** Await review in Approval Queue
    PENDING_APPROVAL : **Constraint:** Excluded from Neo4j & Qdrant
}

PENDING_APPROVAL --> REJECTED : Knowledge Admin clicks Reject\n[rejection_reason != null] (FR54)

state REJECTED #FEE2E2 {
    REJECTED : **Entry:** Record rejection_reason in document_approvals
    REJECTED : **Do:** Write Audit Log (DOC_REJECTED) & notify uploader
    REJECTED : **Invariant:** Never ingested into Knowledge Graph
}

REJECTED --> [*] : Workflow terminated (Rejected)

PENDING_APPROVAL --> APPROVED : Knowledge Admin clicks Approve\n[Role == knowledge_manager] (FR54)

state APPROVED #DCFCE7 {
    APPROVED : **Entry:** Record approval in document_approvals
    APPROVED : **Do:** Write Audit Log (DOC_APPROVED) & enqueue Celery task
}

APPROVED --> PROCESSING_INGESTION : Celery worker starts ETL task\n[process_document_ingestion]

state PROCESSING_INGESTION {
    PROCESSING_INGESTION : **Step 1:** Text extraction & semantic chunking
    PROCESSING_INGESTION : **Step 2:** Generate 768-d embeddings -> Qdrant
    PROCESSING_INGESTION : **Step 3:** LLM NER/RE extraction -> Neo4j Graph
}

PROCESSING_INGESTION --> INDEXED_READY : Qdrant & Neo4j indexing completed

state INDEXED_READY #DCFCE7 {
    INDEXED_READY : **Entry:** Update document indexing metadata
    INDEXED_READY : **Do:** Available for Hybrid GraphRAG Copilot queries
}

INDEXED_READY --> [*] : Lifecycle complete
@enduml