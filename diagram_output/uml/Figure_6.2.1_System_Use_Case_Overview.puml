title System Use Case Overview Diagram — GraphMind Platform (UC.01 to UC.27)
left to right direction

actor "System & IT\nAdministrator" as ITAdmin
actor "Knowledge\nAdministrator" as KAdmin
actor "Executive" as Exec
actor "Department\nManager" as Mgr
actor "Standard User" as User

actor "AEGIS Local Agent\n<<System>>" as Aegis
actor "Ollama Local LLM\n<<System>>" as Ollama
actor "SMTP Email Server\n<<System>>" as Smtp

rectangle "GraphMind Enterprise Knowledge Management Platform" {
    package "1. Administration & Security Subsystem" as P1 {
        usecase "UC.01 System Login" as UC01
        usecase "UC.02 Manage Accounts, Departments & Identities" as UC02
        usecase "UC.03 Granular Access Authorization (RBAC)" as UC03
        usecase "UC.04 Audit Log View & Data Protection" as UC04
        usecase "UC.05 LLMOps Token & Cost Monitoring" as UC05
        usecase "UC.26 Dynamic RBAC, Session JTI & Email OTP" as UC26
        usecase "UC.27 Threat Mitigation & Workstation Kill Switch" as UC27
    }

    package "2. Data Pipeline & Ingestion Subsystem" as P2 {
        usecase "UC.06 Cloud Data Source Connection Management" as UC06
        usecase "UC.07 Workstation Monitoring & AEGIS Agent" as UC07
        usecase "UC.08 Sync Calendar & Incremental Sync" as UC08
        usecase "UC.09 Sync Log & Data Flow Monitoring" as UC09
        usecase "UC.10 Data Loading & Preprocessing" as UC10
        usecase "UC.11 Automatic Entity & Relational Extraction" as UC11
        usecase "UC.12 Document Browsing & File Preview" as UC12
        usecase "UC.23 Internal Document Upload & Approval Workflow" as UC23
    }

    package "3. Knowledge Graph & Hybrid AI Copilot Subsystem" as P3 {
        usecase "UC.13 Human-Involved Knowledge Editing" as UC13
        usecase "UC.14 SOP Drafting & Internal Knowledge Wiki" as UC14
        usecase "UC.15 Q&A with Hybrid AI Copilot (GraphRAG)" as UC15
        usecase "UC.16 View Knowledge Graphs & Inference Lines" as UC16
        usecase "UC.17 See Source Citations" as UC17
        usecase "UC.18 Chat Session Management & Shared Notes" as UC18
    }

    package "4. Shift Handover & Executive Analytics Subsystem" as P4 {
        usecase "UC.19 View Executive KPIs" as UC19
        usecase "UC.20 Intelligent Risk Alert Tracking" as UC20
        usecase "UC.21 Automatic Executive Summary Report" as UC21
        usecase "UC.22 Multifaceted Unified Search & Filtering" as UC22
        usecase "UC.24 Departmental Shift Handover & Sign-Off" as UC24
        usecase "UC.25 Daily Automated Shift Consolidation" as UC25
    }
}

P1 -[hidden]right-> P3
P2 -[hidden]right-> P4

