title Figure 6.9 — Shift Handover Report State Machine Diagram (FR55–FR57)

[*] --> DRAFT : Employee clicks Save Draft\n[status = 'DRAFT'] (FR55)
[*] --> SUBMITTED : Employee clicks Submit Report directly\n[Mandatory fields valid] (FR55)

state DRAFT {
    DRAFT : **Entry:** Save partial shift handover form
    DRAFT : **Do:** Editable by authoring employee only
    DRAFT : **Visibility:** Hidden from Manager Review Queue
}

DRAFT --> DRAFT : Employee updates tasks, incidents or notes
DRAFT --> SUBMITTED : Employee clicks Submit Report\n[completed_tasks & handover_notes != empty] (FR55)

state SUBMITTED #FEF3C7 {
    SUBMITTED : **Entry:** Lock report against employee edits
    SUBMITTED : **Do:** Notify Department Manager & display in Review Queue
}

SUBMITTED --> REJECTED : Department Manager clicks Request Revision\n[Manager remarks / reason provided] (FR56)

state "REJECTED (Revision Requested)" as REJECTED #FEE2E2 {
    REJECTED : **Entry:** Record manager remarks & write Audit Log
    REJECTED : **Do:** Unlock form & notify employee to revise
}

REJECTED --> DRAFT : Employee opens report to edit & correct content

SUBMITTED --> APPROVED : Department Manager clicks Sign-off & Approve\n[signed_by_manager_id & approved_at recorded] (FR56)

state APPROVED #DCFCE7 {
    APPROVED : **Entry:** Permanently lock shift report content
    APPROVED : **Do:** Write Audit Log (SHIFT_APPROVED)
    APPROVED : **Status:** Ready for Daily Shift Consolidation
}

APPROVED --> CONSOLIDATED : Daily Consolidation Job (23:00 Cron or Manual)\n[Aggregated via Local Ollama LLM or Rule-Based Fallback] (FR57)

state CONSOLIDATED #DCFCE7 {
    CONSOLIDATED : **Entry:** Linked to shift_daily_summaries record
    CONSOLIDATED : **Do:** Published on Executive & Manager Dashboard
}

CONSOLIDATED --> [*] : Shift lifecycle complete
@enduml