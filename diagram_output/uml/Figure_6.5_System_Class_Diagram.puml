@startuml

skinparam dpi 110
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam defaultFontColor #1E293B
skinparam ArrowColor #1F3A5F
skinparam ArrowThickness 1.3
skinparam ArrowFontColor #1E293B
skinparam ArrowFontSize 11
skinparam TitleFontColor #1F3A5F
skinparam TitleFontSize 15
skinparam PackageBorderColor #1F3A5F
skinparam PackageBackgroundColor #F8FAFC
skinparam PackageFontColor #1F3A5F
skinparam PackageFontSize 12
skinparam RectangleBorderColor #1F3A5F
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontColor #1F3A5F
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B
skinparam NoteFontColor #1E293B
skinparam NoteFontSize 11

skinparam linetype ortho
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #EAF2FF
skinparam ClassBorderColor #1F3A5F
skinparam ClassBorderThickness 1.3
skinparam ClassFontColor #1F3A5F
skinparam ClassFontSize 12
skinparam ClassAttributeFontColor #1E293B
skinparam ClassAttributeFontSize 11

hide empty members
title GraphMind Enterprise Knowledge Platform — System Class Diagram (Ver 1.2)

package "1. Identity, Access & Governance (M1)" {
    class User {
        +id : UUID <<PK>>
        +username : String
        +email : String
        +password_hash : String
        +role_id : String
        +department_id : UUID <<FK>>
        +is_active : Boolean
        +created_at : Timestamp
        --
        +authenticate(password: String) : Boolean
        +hasPermission(resource: String, action: String) : Boolean
    }

    class Department {
        +id : UUID <<PK>>
        +name : String
        +code : String
        +description : String
        +manager_id : UUID <<FK>>
        +created_at : Timestamp
        --
        +getScopedDocuments() : List<Document>
        +getShiftReports(date: Date) : List<ShiftReport>
    }

    class RbacPermission {
        +id : UUID <<PK>>
        +role_id : String
        +resource_name : String
        +permission_type : String
        +is_granted : Boolean
        +updated_at : Timestamp
        --
        +validateSelfLockout(adminRole: String) : Boolean
    }

    class UserActiveSession {
        +id : UUID <<PK>>
        +user_id : UUID <<FK>>
        +jti : String <<UNIQUE>>
        +ip_address : String
        +user_agent : String
        +status : String
        +created_at : Timestamp
        +expires_at : Timestamp
        --
        +revokeSession() : void
        +isBlacklisted() : Boolean
    }

    class PasswordResetToken {
        +id : UUID <<PK>>
        +email : String
        +otp_hash : String
        +reset_token : String
        +attempts_count : Int
        +is_used : Boolean
        +expires_at : Timestamp
        --
        +verifyOtp(code: String) : Boolean
    }

    class AuditLog {
        +id : UUID <<PK>>
        +user_id : UUID <<FK>>
        +event_type : String
        +resource_affected : String
        +ip_address : String
        +severity_level : String
        +details_json : JSONB
        +created_at : Timestamp
        --
        +recordImmutableEvent() : void
    }
}

package "2. Data Pipeline, Approval & AEGIS Agent (M2)" {
    class Workstation {
        +id : UUID <<PK>>
        +workstation_name : String
        +ip_address : String
        +os_version : String
        +aegis_version : String
        +status : String
        +last_heartbeat : Timestamp
        --
        +sendHeartbeat() : void
        +triggerEmergencyKill() : Boolean
    }

    class Document {
        +id : UUID <<PK>>
        +title : String
        +file_path : String
        +file_size : Long
        +mime_type : String
        +sha256_hash : String <<INDEX>>
        +status : String
        +department_id : UUID <<FK>>
        +uploaded_by : UUID <<FK>>
        +created_at : Timestamp
        --
        +computeSha256() : String
        +queueForApproval() : void
    }

    class DocumentApproval {
        +id : UUID <<PK>>
        +document_id : UUID <<FK, UNIQUE>>
        +action : String
        +rejection_reason : String
        +approved_by : UUID <<FK>>
        +created_at : Timestamp
        --
        +approveAndTriggerETL() : void
        +rejectDocument(reason: String) : void
    }
}

package "3. Knowledge Graph & Hybrid AI Copilot (M3)" {
    class HybridCopilotEngine {
        +llm_model : String = "Qwen2.5-7B-Instruct"
        +vector_collection : String = "graphmind_chunks"
        +rrf_k : Int = 60
        --
        +executeHybridQuery(question: String, scope: UUID) : CopilotResponse
        +fuseContextRRF(vectorHits: List, graphHits: List) : String
    }

    class CypherGuard {
        +forbidden_keywords : Set<String>
        --
        +validateReadOnlyCypher(cypher: String) : Boolean
        +tokenizeAndInspectAST(cypher: String) : List<String>
    }

    class KGEntity {
        +entity_id : String <<PK>>
        +name : String
        +entity_type : String
        +confidence_score : Float
        --
        +traverseNeighbors(depth: Int) : List<KGEntity>
    }

    class SOPArticle {
        +sop_id : UUID <<PK>>
        +title : String
        +category : String
        +department_id : UUID <<FK>>
        +content_markdown : String
        --
        +publishSOP() : void
    }
}

package "4. Shift Handover & Executive Decision Support (M4)" {
    class ShiftReport {
        +id : UUID <<PK>>
        +user_id : UUID <<FK>>
        +department_id : UUID <<FK>>
        +shift_name : String
        +report_date : Date <<INDEX>>
        +completed_tasks : String
        +issues_encountered : String
        +handover_notes : String
        +status : String
        +signed_by_manager_id : UUID <<FK>>
        +approved_at : Timestamp
        --
        +submitReport() : void
        +signOff(managerId: UUID, remarks: String) : void
        +requestRevision(reason: String) : void
    }

    class ShiftDailySummary {
        +id : UUID <<PK>>
        +department_id : UUID <<FK>>
        +summary_date : Date <<INDEX>>
        +content_markdown : String
        +total_shifts : Int
        +total_issues : Int
        +is_fallback_generated : Boolean
        +created_at : Timestamp
        --
        +consolidateViaOllama(reports: List<ShiftReport>) : void
        +generateRuleBasedFallback(reports: List<ShiftReport>) : void
    }

    class RiskAlert {
        +risk_id : UUID <<PK>>
        +risk_type : String
        +severity : String
        +department_id : UUID <<FK>>
        +detected_at : Timestamp
        --
        +checkNegativeMargin() : Boolean
        +checkAbnormalDiscount(threshold: Float) : Boolean
    }
}

Department "1" -- "0..*" User : employs >
User "1" -- "0..*" UserActiveSession : owns >
User "1" -- "0..*" PasswordResetToken : requests >
User "1" -- "0..*" AuditLog : generates >
User "1" -- "0..*" RbacPermission : governed by >

Department "1" -- "0..*" Document : scopes >
User "1" -- "0..*" Document : uploads >
Document "1" -- "0..1" DocumentApproval : reviewed via >
User "1" -- "0..*" DocumentApproval : approves/rejects >
Workstation "1" -- "0..*" Document : syncs >

Document "1" -- "0..*" KGEntity : extracts >
Department "1" -- "0..*" SOPArticle : governs >
HybridCopilotEngine "1" --> "1" CypherGuard : enforces >
HybridCopilotEngine "1" --> "0..*" KGEntity : queries >

Department "1" -- "0..*" ShiftReport : owns >
User "1" -- "0..*" ShiftReport : authors / signs >
ShiftDailySummary "1" o-- "1..*" ShiftReport : consolidates >
Department "1" -- "0..*" ShiftDailySummary : summarizes >
Department "1" -- "0..*" RiskAlert : monitors >
@enduml