    ActorBackgroundColor #EAF2FF
    ActorFontColor #1F3A5F
    BoxBorderColor #64748B
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #1F3A5F
    GroupBackgroundColor #F1F5F9
    GroupHeaderFontColor #1F3A5F
}

title UC.24 - Departmental Shift Handover Reporting & Sign-off

actor "Standard User\n(Employee)" as User
boundary "Web Dashboard / UI" as UI
control "ShiftRouter" as Router
database "PostgreSQL" as DB
actor "Department\nManager" as Mgr

User -> UI : 1. Open Shift Handover Form & enter shift tasks, incidents, handover notes
alt [A1: Employee Saves as Draft]
    User -> UI : 2a. Click Save Draft
    UI -> Router : 3a. POST /api/v1/shifts/reports (status='DRAFT')
    Router -> DB : 4a. INSERT INTO shift_reports (status='DRAFT')
    DB --> Router : report_id
    Router --> UI : 5a. 201 Created (Saved as editable DRAFT)
else [Main Flow: Employee Submits Shift Report (FR55)]
    User -> UI : 2b. Click Submit Report
    UI -> Router : 3b. POST /api/v1/shifts/reports (status='SUBMITTED')
    Router -> Router : 4b. Validate mandatory fields (completed_tasks, handover_notes)
    alt [E1: Mandatory Field Empty]
        Router --> UI : 400 Bad Request (Missing required fields)
        UI --> User : Highlight missing fields on form
    else [Fields Valid]
        Router -> DB : 5b. INSERT INTO shift_reports (department_id, status='SUBMITTED')
        DB --> Router : report_id
        Router --> UI : 6b. 201 Created (Report locked & submitted)
        UI --> User : Display submission confirmation

        Mgr -> UI : 7. Open Department Shift Reviews
        UI -> Router : 8. GET /api/v1/shifts/pending-reviews?department_id=dept_id
        Router -> DB : 9. SELECT * FROM shift_reports WHERE department_id=dept_id AND status='SUBMITTED'
        DB --> Router : Submitted shift reports list
        Router --> UI : 10. Return departmental shift reports
        UI --> Mgr : Display shift report details

        alt [Main Flow: Manager Signs Off & Approves (FR56)]
            Mgr -> UI : 11a. Enter Manager Remarks & click Sign-off & Approve
            UI -> Router : 12a. POST /api/v1/shifts/reports/{id}/sign-off (action='APPROVE', remarks)
            Router -> DB : 13a. UPDATE shift_reports SET status='APPROVED',\nsigned_by_manager_id=mgr_id, approved_at=now()
            Router -> DB : 14a. INSERT INTO audit_logs (event='SHIFT_APPROVED')
            Router --> UI : 15a. 200 OK (Shift Report Approved & Locked)
            UI --> Mgr : Display sign-off confirmation
        else [A2: Manager Requests Revision]
            Mgr -> UI : 11b. Enter revision remarks & click Request Revision
            UI -> Router : 12b. POST /api/v1/shifts/reports/{id}/sign-off (action='REJECT', remarks)
            Router -> DB : 13b. UPDATE shift_reports SET status='REJECTED' (unlock for employee)
            Router -> DB : 14b. INSERT INTO audit_logs (event='SHIFT_REVISION_REQUESTED')
            Router --> UI : 15b. 200 OK (Status = REJECTED)
            UI --> User : Notify employee to revise and resubmit
        end
    end
end
@enduml