# ==========================================
# GraphMind (EKAI) — Environment Variables
# ==========================================

# Application
APP_ENV=development
PORT=5000
FRONTEND_PORT=5173

# Security & Authentication
SECRET_KEY=change-me-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Relational Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=graphmind
POSTGRES_PASSWORD=graphmind_secret
POSTGRES_DB=graphmind_db
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmind_secret

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=enterprise_knowledge

# Self-Hosted LLM Inference (Qwen2.5-7B-Instruct fine-tuned)
INFERENCE_ENGINE_URL=http://localhost:8000/v1
MODEL_NAME=qwen2.5-7b-instruct-graphmind

# AEGIS Local Agent
AEGIS_AGENT_API_KEY=dev-agent-key
